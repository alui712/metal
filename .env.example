# Copy to .env.local and fill in. Never commit real values.

# Claude API key (server-only). Used for visual analysis, titles/summaries,
# and natural-language edits. Leave empty to run without these features.
ANTHROPIC_API_KEY=

# Where METAL stores its database, imported media, and exports.
# Relative paths resolve from the project root. Default: data
# METAL_DATA_DIR=data

# Tool locations (defaults assume they are on PATH, e.g. via Homebrew).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# WHISPER_PATH=whisper-cli
# WHISPER_MODEL_PATH=models/ggml-base.en.bin   (default: models/, then data/models/)
# WHISPER_VAD_PATH=whisper-vad-speech-segments
# WHISPER_VAD_MODEL_PATH=models/ggml-silero-v5.1.2.bin
# EMBED_MODEL_DIR=models            (expects models/Xenova/all-MiniLM-L6-v2/ and clip-vit-base-patch16/)
# VISUAL_MODEL_ID=Xenova/clip-vit-base-patch16

# Hand-checked Recall tags (optional). Default: <data dir>/recall-tags.json
# METAL_RECALL_TAGS=data/recall-tags.json

# Public online demo only: read-only mode (refuses every write, hides
# capture/import pages). Must be set at build time and at run time.
# METAL_PUBLIC_DEMO=1
