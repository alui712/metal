# Copy to .env.local and fill in. Never commit real values.

# Claude API key (server-only). Used for visual analysis, titles/summaries,
# and natural-language edits. Leave empty to run without these features.
ANTHROPIC_API_KEY=

# Where METAL stores its database, imported media, and exports.
# Relative paths resolve from the project root. Default: data
# METAL_DATA_DIR=data

# Tool locations (defaults assume they are on PATH, e.g. via Homebrew).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# WHISPER_PATH=whisper-cli
# WHISPER_MODEL_PATH=data/models/ggml-base.en.bin
