// Generates the online demo's Multi-POV pair: two synthetic clips of one
// fictional moment (no real gameplay, voices or players), then measures their
// offset with METAL's own audio sync, so the demo shows a real measurement
// made at build time — not a live one.
//
//   npx tsx scripts/public-demo/make-pov-demo.mts
//
// Writes public/demo/pov/{you,kai}.{mp4,jpg} and src/lib/pov/demo-pov.json.
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { alignEnvelopes, classifyAlignment, decodeEnvelope } from "../../src/server/pov/audio-sync";
import { burstTrack, SAMPLE_RATE, writeWav } from "../../src/server/pov/pov-samples";

const OUT = "public/demo/pov";
/** Kai starts 2.4 s after you on the shared timeline. */
const POVS = [
  { name: "you", startS: 0, lenS: 20, colors: ["0x08201f", "0x0f5c55", "0x3b2a7a"], seed: 11 },
  { name: "kai", startS: 2.4, lenS: 16, colors: ["0x1f1408", "0x6b3d12", "0x4a2a7a"], seed: 23 },
];
/** Shared-timeline seconds where both clips flash (the "same moment"). */
const FLASHES = [5, 10, 15];

fs.mkdirSync(OUT, { recursive: true });
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "metal-pov-demo-"));
const total = Math.max(...POVS.map((p) => p.startS + p.lenS)) + 1;
const voice = burstTrack(total, 42); // the shared "voice chat": seeded tone bursts

for (const p of POVS) {
  const game = burstTrack(p.lenS, p.seed, { gain: 0.3, density: 0.7 });
  const s0 = Math.round(p.startS * SAMPLE_RATE);
  for (let i = 0; i < game.length; i++) game[i] += (voice[s0 + i] ?? 0) * 0.8;
  const wav = path.join(tmp, `${p.name}.wav`);
  writeWav(wav, game);
  const flash = FLASHES.map((s) => `between(t,${(s - p.startS).toFixed(2)},${(s - p.startS + 0.25).toFixed(2)})`).join("+");
  const vf = [
    `drawgrid=w=80:h=80:t=1:c=white@0.10`,
    `drawbox=x='mod(t*${p.name === "you" ? 140 : 110},iw)':y=ih*0.62:w=36:h=36:color=white@0.85:t=fill`,
    `drawbox=x=0:y=0:w=iw:h=ih:color=white@0.55:t=fill:enable='${flash}'`,
    `vignette`,
  ].join(",");
  const mp4 = path.join(OUT, `${p.name}.mp4`);
  execFileSync("ffmpeg", [
    "-hide_banner", "-loglevel", "error", "-y",
    "-f", "lavfi", "-i", `gradients=s=960x540:r=30:d=${p.lenS}:n=3:c0=${p.colors[0]}:c1=${p.colors[1]}:c2=${p.colors[2]}:speed=0.015:seed=${p.seed}`,
    "-i", wav,
    "-vf", vf,
    "-c:v", "libx264", "-preset", "slow", "-crf", "30", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "64k", "-shortest", "-movflags", "+faststart",
    mp4,
  ]);
  execFileSync("ffmpeg", ["-hide_banner", "-loglevel", "error", "-y", "-ss", "1", "-i", mp4, "-frames:v", "1", "-q:v", "5", path.join(OUT, `${p.name}.jpg`)]);
}
fs.rmSync(tmp, { recursive: true });

// METAL's real audio sync on the generated files (the worker's pov-match uses the same functions).
const [a, b] = await Promise.all(POVS.map((p) => decodeEnvelope(path.join(OUT, `${p.name}.mp4`))));
if (!a || !b) throw new Error("couldn't decode the demo clips' audio");
const al = alignEnvelopes(a, b);
const result = {
  note: "Synthetic clips generated by scripts/public-demo/make-pov-demo.mts. `measured` is METAL's audio sync run on them when the demo was built.",
  generatedOffsetMs: Math.round((POVS[1].startS - POVS[0].startS) * 1000),
  measured: al ? { offsetMs: al.offsetMs, score: Math.round(al.score * 1000) / 1000, status: classifyAlignment(al) } : null,
  members: POVS.map((p) => ({ name: p.name, durationMs: Math.round(p.lenS * 1000) })),
};
fs.writeFileSync("src/lib/pov/demo-pov.json", JSON.stringify(result, null, 2) + "\n");
console.log(JSON.stringify(result.measured), "generated", result.generatedOffsetMs, "ms");
for (const f of fs.readdirSync(OUT)) console.log(f, fs.statSync(path.join(OUT, f)).size);
